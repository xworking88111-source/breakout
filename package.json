{
  "name": "breakout",
  "version": "0.1.0",
  "private": true,
  "description": "Breakout 破圈 — bilingual, data-driven recommendation index for short dramas, anime, novels and films",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --dir app dev",
    "build": "pnpm --dir app build",
    "preview": "pnpm --dir app preview",
    "data:fetch": "node scripts/fetch_anilist.mjs",
    "data:build": "node scripts/build_dataset.mjs",
    "data:validate": "node scripts/validate_dataset.mjs",
    "data:all": "npm run data:fetch && npm run data:import && npm run data:build && npm run data:validate && npm run data:analyze && npm run data:benchmark",
    "data:benchmark": "node scripts/benchmark.mjs",
    "data:analyze": "node scripts/analyze_hits.mjs",
    "data:snapshot": "node scripts/snapshot.mjs",
    "data:backtest": "node scripts/backtest.mjs",
    "data:titles": "node scripts/fetch_title_map.mjs && node scripts/fetch_bangumi_titles.mjs",
    "data:import": "node scripts/import_shortdrama.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "opencc-js": "^1.4.2"
  }
}